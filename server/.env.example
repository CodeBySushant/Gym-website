# Copy this file to server/.env and fill in the values.

# MongoDB connection — local install or a free MongoDB Atlas cluster
MONGODB_URI=mongodb://127.0.0.1:27017/supermen-fitness-gym

# The single admin login for the site
ADMIN_EMAIL=mesushant.official@gmail.com
ADMIN_PASSWORD=change-this-password

# Any long random string — used to sign login sessions
JWT_SECRET=replace-with-a-long-random-string

PORT=5000
