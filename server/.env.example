# Copy this file to server/.env and fill in the values.

# MongoDB connection — local install or a free MongoDB Atlas cluster
MONGODB_URI=mongodb://127.0.0.1:27017/supermen-fitness-gym

# The single admin login for the site
ADMIN_EMAIL=mesushant.official@gmail.com
ADMIN_PASSWORD=change-this-password

# Any long random string — used to sign login sessions
JWT_SECRET=replace-with-a-long-random-string

PORT=5000

# Timezone the gym operates in. Drives attendance days, streaks and plan
# expiry, so they stay correct even when the host runs on UTC.
GYM_TIMEZONE=Asia/Kolkata

# Where uploaded images are written. Leave unset for local development.
# In production point this at a MOUNTED PERSISTENT VOLUME — on an ephemeral
# disk every redeploy deletes the gym's photos.
# UPLOADS_DIR=/var/data/uploads

# --------------------------- SECURITY ---------------------------

# How many reverse proxies sit in front of this server. 0 = none (local dev, or
# a directly-exposed port). Behind nginx / one load balancer, set 1.
# NEVER set this to `true` — that trusts the whole X-Forwarded-For chain and
# lets a client forge its own IP, defeating the login rate limit.
TRUST_PROXY=0

# Comma-separated origins allowed to call the API. Leave unset in development.
# CORS_ORIGIN=https://supermenfitness.com

# Set to true to send the Content-Security-Policy as report-only while you
# verify nothing legitimate is being blocked. Switch back to enforcing before launch.
# CSP_REPORT_ONLY=true

# Member progress photos are stored here, OUTSIDE the publicly served uploads
# directory, and are reachable only through short-lived signed links.
# Defaults to a sibling of UPLOADS_DIR. Put it on the same persistent volume.
# PRIVATE_UPLOADS_DIR=/var/data/private-uploads

# Session lifetime in days for member portal logins.
SESSION_DAYS_MEMBER=7
